{
  "expo": {
    "name": "Tyohar",
    "slug": "tyohar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tyohar",
    "userInterfaceStyle": "light",
    "description": "Book puja and hawan at temples across India, send bhet, or have Tyohar collect your offering from home and submit it at the temple. Prasad can come back to your door.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.tyohar.app"
    },
    "android": {
      "package": "in.tyohar.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6B1D1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["INTERNET"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#6B1D1D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
